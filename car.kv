#:kivy 1.11.1

<Car>:
    size_hint: None, None
    size: 20, 10
    canvas.before:
        PushMatrix
        Rotate:
            angle: self.angle
            origin: self.center
    canvas:
        Rectangle:
            pos: self.pos
            size: self.size
    canvas.after:
        PopMatrix

<Ball1>:
    size_hint: None, None
    size: 10, 10
    canvas:
        Color:
            rgba: 1, 0, 0, 1
        Ellipse:
            pos: self.pos
            size: self.size

<Ball2>:
    size_hint: None, None
    size: 10, 10
    canvas:
        Color:
            rgba: 0, 1, 1, 1
        Ellipse:
            pos: self.pos
            size: self.size

<Ball3>:
    size_hint: None, None
    size: 10, 10
    canvas:
        Color:
            rgba: 1, 1, 0, 1
        Ellipse:
            pos: self.pos
            size: self.size

<Game>:
    car: game_car
    ball1: game_ball1
    ball2: game_ball2
    ball3: game_ball3

    Car:
        id: game_car
        center: self.center
    Ball1:
        id: game_ball1
        center: self.center
    Ball2:
        id: game_ball2
        center: self.center
    Ball3:
        id: game_ball3
        center: self.center
